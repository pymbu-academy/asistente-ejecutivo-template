{
  "_comentario": [
    "PLANTILLA de conexiones MCP. Copiala a '.mcp.json' (cp .mcp.json.example .mcp.json) y dejá solo los servers que uses.",
    "REGLA DE ORO: NUNCA escribas tokens acá. Usá ${VAR}; el valor real va en .claude/settings.local.json (sección 'env').",
    "Claude Code carga settings.local.json solo y expande ${VAR} / ${VAR:-default} acá. Arrancás con 'claude' normal.",
    "Borrá este bloque _comentario en tu .mcp.json real."
  ],
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    }
  }
}
