# Secretos y configuración local — NUNCA se suben al repo
# (los comentarios van en su PROPIA línea: un # al lado del patrón rompe el patrón)
# .env                = TODAS tus credenciales (tokens, API keys, secrets)
# .mcp.json           = conexiones MCP de Claude Code (toman los tokens del .env)
# .codex/config.toml  = configuración local de Codex, incluidos sus MCP
.env
.mcp.json
.codex/config.toml

# .claude/: se versiona settings.json (declara los hooks). Las skills instaladas y los permisos
# locales NO: las skills las reinstala setup.sh.
.claude/*
!.claude/settings.json

# Skills instaladas para Codex (las reinstala setup.sh; se sincronizan con .claude/skills)
.agents/

# Sistema y dependencias
.DS_Store
node_modules/
__pycache__/

# Artefactos transitorios
Projects/*/.tmp/
download.html
download.txt
*.log
