{
  "description": "Hooks del asistente ejecutivo. Son los mismos scripts que usa Claude Code (.claude/settings.json).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/Tools/hooks/session-start-git-pull.sh\"",
            "statusMessage": "Sincronizando con GitHub"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/Tools/hooks/hora-local.py\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/Tools/hooks/memoria-indice.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/Tools/hooks/hora-local.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/Tools/hooks/hora-local.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/Tools/hooks/memoria-indice.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/Tools/hooks/session-log-guard.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/Tools/hooks/session-log-guard.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
